APIFY_TOKEN=
APIFY_ACTOR_ID=compass~crawler-google-places
# Google Analytics 4 measurement id (G-…)
NEXT_PUBLIC_GA_ID=
# Google Sheet log of finished diagnoses: spreadsheet id (from its URL /d/<id>/edit) and the tab:
# GOOGLE_SHEET_GID (#gid=<n> in the URL) first, GOOGLE_SHEET_NAME when no gid is set
GOOGLE_SHEET_ID=
GOOGLE_SHEET_GID=
GOOGLE_SHEET_NAME=
# Service account with Editor access to the sheet; the key on one line, line breaks as \n, in double quotes
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Public address of the site (https://…), used for the report links written to the Google Sheet.
# Leave empty on Vercel and local dev (the request's own address is used); set it in Docker, where that address is 0.0.0.0:3000.
SITE_URL=
